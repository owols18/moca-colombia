# SMTP credentials are private server-side variables. Never expose them with NEXT_PUBLIC_*.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Usually the same verified address as SMTP_USER.
CONTACT_FROM_EMAIL=

# Provisional recipient confirmed for phase 1.
CONTACT_TO_EMAIL=fabian.andres82@gmail.com
